# --- Azure Foundry / Claude ---
# Option A: API key auth (simpler for local dev)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# Option B: Entra ID auth (preferred for eventual production).
# If ANTHROPIC_FOUNDRY_API_KEY is unset, the SDK falls back to
# DefaultAzureCredential (az login works locally).

# Deployment names as configured in Foundry portal
FOUNDRY_REVIEWER_MODEL=claude-sonnet-4-6
FOUNDRY_CONSOLIDATOR_MODEL=claude-sonnet-4-6

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SNAPSHOT_DIR=./data/snapshots
LOG_LEVEL=INFO

# CORS origins for the add-in frontend (comma-separated)
CORS_ORIGINS=https://localhost:3000
